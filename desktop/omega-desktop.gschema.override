[org.mate.background]
picture-options='none'
primary-color='#0d1117'
secondary-color='#0d1117'
color-shading-type='solid'

[org.mate.interface]
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
gtk-color-scheme='bg_color:#0d1117\nfg_color:#c9d1d9\nbase_color:#161b22\ntext_color:#c9d1d9\nselected_bg_color:#ff2d78\nselected_fg_color:#ffffff\ntooltip_bg_color:#161b22\ntooltip_fg_color:#c9d1d9'

[org.mate.Marco.general]
theme='Adwaita-dark'
titlebar-font='Monospace Bold 11'
compositing-manager=true

[org.mate.Marco.global-keybindings]
run-command-terminal='<Control><Alt>t'

[org.mate.terminal.profile:/org/mate/terminal/profiles/default/]
foreground-color='#FF2D78'
background-color='#0D1117'
use-theme-colors=false
bold-color='#FF2D78'
palette='#0D1117:#FF2D78:#39FF14:#FFD700:#58A6FF:#BD93F9:#8BE9FD:#C9D1D9:#484F58:#FF2D78:#39FF14:#FFD700:#58A6FF:#BD93F9:#8BE9FD:#F0F6FC'
scrollback-unlimited=true
font='Monospace 11'
use-system-font=false

[org.mate.panel]
default-layout='omega'

[org.mate.panel.toplevel:/org/mate/panel/toplevels/top/]
background-type='color'
background-color='#0d1117'
size=28

[org.mate.NotificationDaemon]
theme='slider'
