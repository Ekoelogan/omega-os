#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  omega-portable: run omega-cli directly from this drive, no installation
#  Works on any Linux x86_64 with Python 3.9+
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUNDLE_DIR="$SCRIPT_DIR/omega-cli-bundle"
VENV_DIR="$BUNDLE_DIR/venv"
OMEGA_SRC="$BUNDLE_DIR/omega-cli"

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; NC='\033[0m'

banner() {
cat <<'EOF'
  ██████╗ ███╗   ███╗███████╗ ██████╗  █████╗ 
 ██╔═══██╗████╗ ████║██╔════╝██╔════╝ ██╔══██╗
 ██║   ██║██╔████╔██║█████╗  ██║  ███╗███████║
 ██║   ██║██║╚██╔╝██║██╔══╝  ██║   ██║██╔══██║
 ╚██████╔╝██║ ╚═╝ ██║███████╗╚██████╔╝██║  ██║
  ╚═════╝ ╚═╝     ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝
  Portable OSINT Toolkit v0.3.0 — WD Passport Edition
EOF
}

banner

# Check Python
if ! command -v python3 &>/dev/null; then
    echo -e "${RED}[!] Python 3 not found on this system.${NC}"
    echo    "    Install it with: sudo apt install python3 python3-venv"
    exit 1
fi

PY_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
echo -e "${CYAN}[*] Python $PY_VER detected${NC}"

# Build venv if not present
if [ ! -d "$VENV_DIR" ]; then
    echo -e "${CYAN}[*] First run — building virtual environment on drive...${NC}"
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --quiet --upgrade pip
    "$VENV_DIR/bin/pip" install --quiet -e "$OMEGA_SRC"
    echo -e "${GREEN}[✓] omega-cli installed into portable venv${NC}"
else
    echo -e "${GREEN}[✓] Portable venv ready${NC}"
fi

# Run omega with all args passed through
exec "$VENV_DIR/bin/omega" "$@"
